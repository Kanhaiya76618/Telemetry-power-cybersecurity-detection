# Copy to .env (repo root) — read by the backend. Never commit .env.

# --- MQTT (local Wi-Fi now; point at the MEC broker later — no code changes needed)
MQTT_ENABLED=true
MQTT_HOST=localhost          # backend runs on the Mac, so localhost is right HERE (not in the ESP32!)
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=mec-backend
TOPIC_PREFIX=campus

# --- Thresholds (keep CRITICAL in sync with TEMPERATURE_THRESHOLD in the ESP32 sketch;
#     the backend also pushes live values to the device on campus/<node>/config)
WARNING_THRESHOLD_C=40
CRITICAL_THRESHOLD_C=45
RECOVERY_THRESHOLD_C=43
RECOVERY_SECONDS=10
OFFLINE_TIMEOUT_SECONDS=10

# --- Security (P6)
ALLOWED_NODES=node1          # provisioned device allow-list
DEVICE_HMAC_KEY=             # optional shared key; must equal DEVICE_HMAC_KEY in the sketch
FLOOD_MAX_PER_SEC=5
API_TOKEN=                   # set for lab use; dashboard Settings -> API key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DB_PATH=/absolute/path/emergency.db   (default: backend/data/emergency.db)
SIMULATION_NODE=node1-sim
